-- วนลูปเปอร์เซ็นต์โดยอ้างอิงตรงจากตัวแปรในส่วนที่ 1 ทันที แก้ปัญหาค้าง 0%
task.spawn(function()
    for i = 0, 100, 1 do
        if i == 5 then LoadStatus.Text = "กำลังจัดเตรียมระบบคอร์ต่อสู้..."
        elseif i == 45 then LoadStatus.Text = "สร้างปุ่มสวิตช์ฟังก์ชันแคปซูล..."
        elseif i == 85 then LoadStatus.Text = "สร้างหมวดหมู่ AIM พรีเมียมเสร็จสิ้น..." end
        PercentLabel.Text = tostring(i) .. "%"
        BarFill.Size = UDim2.new(i / 100, 0, 1, 0)
        task.wait(i < 30 and 0.01 or 0.015)
    end
    task.wait(0.4)
    LoadingFrame:Destroy()
    MenuVisible, MainWindow.Visible, ToggleButton.Visible = true, true, true
end)
