local function createFeatureToggle(titleText, layoutOrder, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 50)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(24, 25, 30)
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.LayoutOrder = layoutOrder
    ToggleFrame.Parent = Container

    local FrameCorner = Instance.new("UICorner") FrameCorner.CornerRadius = UDim.new(0, 10) FrameCorner.Parent = ToggleFrame
    local FrameStroke = Instance.new("UIStroke") FrameStroke.Thickness = 1 FrameStroke.Color = Color3.fromRGB(40, 42, 52) FrameStroke.Parent = ToggleFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.6, 0, 1, 0)
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = titleText
    Label.TextColor3 = Color3.fromRGB(230, 230, 235)
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ToggleFrame

    local SwitchBg = Instance.new("TextButton")
    SwitchBg.Size = UDim2.new(0, 46, 0, 24)
    SwitchBg.Position = UDim2.new(1, -58, 0.5, -12)
    SwitchBg.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
    SwitchBg.Text = ""
    SwitchBg.BorderSizePixel = 0
    SwitchBg.Parent = ToggleFrame

    local SwitchBgCorner = Instance.new("UICorner") SwitchBgCorner.CornerRadius = UDim.new(1, 0) SwitchBgCorner.Parent = SwitchBg

    local SwitchBall = Instance.new("Frame")
    SwitchBall.Size = UDim2.new(0, 18, 0, 18)
    SwitchBall.Position = UDim2.new(0, 3, 0.5, -9)
    SwitchBall.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SwitchBall.BorderSizePixel = 0
    SwitchBall.Parent = SwitchBg

    local BallCorner = Instance.new("UICorner") BallCorner.CornerRadius = UDim.new(1, 0) BallCorner.Parent = SwitchBall

    local isEnabled = false
    SwitchBg.MouseButton1Click:Connect(function()
        isEnabled = not isEnabled
        local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        if isEnabled then
            TweenService:Create(SwitchBall, tweenInfo, {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
            TweenService:Create(SwitchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(115, 90, 255)}):Play()
        else
            TweenService:Create(SwitchBall, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
            TweenService:Create(SwitchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(55, 55, 62)}):Play()
        end
        if callback then callback(isEnabled) end
    end)
end

