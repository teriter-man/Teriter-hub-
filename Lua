local function ToggleMenu()
    MenuVisible = not MenuVisible
    MainWindow.Visible = MenuVisible
end

local MaximizeBtn
local function ToggleMaximize()
    IsMaximized = not IsMaximized
    if IsMaximized then
        if MainWindow.Size == NormalSize then NormalPosition = MainWindow.Position end
        MainWindow.Size = UDim2.new(1, 0, 1, 0) MainWindow.Position = UDim2.new(0, 0, 0, 0)
        MainWindow.Draggable = false MainCorner.CornerRadius = UDim.new(0, 0) MainStroke.Thickness = 0
        Sidebar.Size = UDim2.new(0, 142, 1, -75) Container.Size = UDim2.new(1, -177, 1, -75)
        if MaximizeBtn then MaximizeBtn.Text = "🗖" end
    else
        MainWindow.Size = NormalSize MainWindow.Position = NormalPosition
        MainWindow.Draggable = true MainCorner.CornerRadius = UDim.new(0, 12) MainStroke.Thickness = 1.5
        Sidebar.Size = UDim2.new(0, 132, 0, 285) Container.Size = UDim2.new(0, 383, 0, 285)
        if MaximizeBtn then MaximizeBtn.Text = "▢" end
    end
end

local function createWinBtn(text, font, size, isClose, order, onClick)
    local btn = Instance.new("TextButton")
    btn.LayoutOrder = order btn.Font = font btn.TextSize = size btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255) btn.BorderSizePixel = 0 btn.Parent = ControlBox
    if isClose then
        btn.Size = UDim2.new(0, 28, 0, 28) btn.BackgroundColor3 = Color3.fromRGB(232, 17, 35)
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = btn
    else
        btn.Size = UDim2.new(0, 32, 0, 28) btn.BackgroundTransparency = 1 btn.BackgroundColor3 = Color3.fromRGB(48, 50, 62)
        btn.MouseEnter:Connect(function() btn.BackgroundTransparency = 0 end)
        btn.MouseLeave:Connect(function() btn.BackgroundTransparency = 1 end)
    end
    if onClick then btn.MouseButton1Click:Connect(onClick) end
    return btn
end

